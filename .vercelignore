# Ignore everything by default because this workspace also contains large
# local reports, scans, and temporary PDF-processing outputs.
*

# Keep app source and static assets.
!src
!src/**
!public
!public/**

# Exclude old generated report files from the deployed app.
public/reports
public/reports/**

# Keep only web-ready reference PDFs in the deployed app.
public/reference/*.pdf
!public/reference/2026-social-welfare-facility-guide.pdf
!public/reference/social-welfare-center-hr-labor-guide-web.pdf
!public/reference/2025-social-welfare-inspection-casebook.pdf
!public/reference/2027-social-welfare-center-evaluation-corrected.pdf

# Keep build and package configuration.
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!eslint.config.mjs
!.vercelignore
!README.md
